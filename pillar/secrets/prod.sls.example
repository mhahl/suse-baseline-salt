# =====================================================================
# EXAMPLE — encrypted pillar overlay for production secrets.
#
# Copy to pillar/secrets/prod.sls, replace the PASTE-* blocks with real
# `gpg --encrypt --armor` output, and target it from pillar/top.sls
# AFTER the defaults (later wins in pillar merge):
#
#   base:
#     '*':
#       - baseline
#       - overstate
#     'salt-prod-*':
#       - secrets.prod
#
# The .example suffix means Salt never loads THIS file — only the real
# prod.sls (ciphertext) is rendered. Ciphertext is safe to commit; the
# private key in /etc/salt/gpgkeys (see master.d/gpg.conf.example) must
# NEVER be committed. Full workflow: README.md "Secrets" section.
#
# Encrypt each value (no trailing newline):
#   echo -n 's3cret' | gpg --encrypt --armor -r <master-key-id>
# =====================================================================
#!yaml|gpg
baseline:
  freeipa:
    join:
      enabled: true
      domain: 'example.com'
      principal: 'svc-enroll'
      password: |
        -----BEGIN PGP MESSAGE-----
        PASTE-GPG-CIPHERTEXT-FOR-IPA-SVC-PASSWORD
        -----END PGP MESSAGE-----
  netbird:
    join:
      enabled: true
      setup_key: |
        -----BEGIN PGP MESSAGE-----
        PASTE-GPG-CIPHERTEXT-FOR-NETBIRD-SETUP-KEY
        -----END PGP MESSAGE-----
  proxy:
    # Only needed when the proxy itself requires authentication.
    http_proxy: |
      -----BEGIN PGP MESSAGE-----
      PASTE-GPG-CIPHERTEXT-FOR-PROXY-URL-e.g-http://user:pass@proxy:8080
      -----END PGP MESSAGE-----
    https_proxy: |
      -----BEGIN PGP MESSAGE-----
      PASTE-GPG-CIPHERTEXT-FOR-PROXY-URL-e.g-http://user:pass@proxy:8080
      -----END PGP MESSAGE-----

# Future overstate secrets (none required today — overstate:grype has no
# secret fields) follow the same pattern:
# overstate:
#   some_integration:
#     api_token: |
#       -----BEGIN PGP MESSAGE-----
#       PASTE-GPG-CIPHERTEXT-FOR-API-TOKEN
#       -----END PGP MESSAGE-----
