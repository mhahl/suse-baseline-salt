{% set dns = salt['pillar.get']('baseline:systemd_resolved', {}) %}
{# DNS-over-TLS forwarding resolver via the dns/unbound package — the
   FreeBSD counterpart of baseline.systemd-resolved. Reads the SAME
   baseline:systemd_resolved pillar: entries look like
   "IP#auth-name" (systemd-resolved syntax) and are rendered as unbound
   forward-addr entries ("IP@853#auth-name") with forward-tls-upstream,
   so fleets configure one DoT resolver list regardless of platform.
   DNSSEC validation is on (root key auto-anchored); negative caching is
   off to mirror systemd-resolved's Cache=no-negative; the stub listens
   on 127.0.0.1 and /etc/resolv.conf points at it.
   FreeBSD note: the base-system local_unbound is deliberately NOT used —
   its config is regenerated by local-unbound-setup, which fights
   file.managed. Do not enable local_unbound on these hosts (both would
   fight over port 53). #}

unbound_package:
  pkg.installed:
    - name: dns/unbound

# Unbound needs the CA bundle to authenticate DoT upstream certificates.
unbound_ca_bundle:
  pkg.installed:
    - name: ca_root_nss
    - require:
      - pkg: unbound_package

unbound_root_key:
  cmd.run:
    - name: unbound-anchor -a /var/db/unbound/root.key
    - unless: test -f /var/db/unbound/root.key
    - require:
      - pkg: unbound_package

unbound_config:
  file.managed:
    - name: /usr/local/etc/unbound/unbound.conf
    - source: salt://baseline/unbound/templates/unbound.conf.jinja
    - template: jinja
    - user: root
    - group: wheel
    - mode: '0640'
    - context:
        dns: {{ dns }}
    - require:
      - pkg: unbound_package

# A broken resolver config takes the whole host's DNS down: validate
# before reloading, and fail hard on a syntax error.
unbound_validate:
  cmd.run:
    - name: unbound-checkconf /usr/local/etc/unbound/unbound.conf
    - onchanges:
      - file: unbound_config
    - failhard: True
    - order: 1

unbound_resolv_conf:
  file.managed:
    - name: /etc/resolv.conf
    - contents: |
        # Managed by baseline.unbound — local stub at 127.0.0.1.
        # A DHCP client may rewrite this on lease events; supersede
        # domain-name-servers 127.0.0.1 in /etc/dhclient.conf to pin it.
        nameserver 127.0.0.1
    - user: root
    - group: wheel
    - mode: '0644'
    - require:
      - pkg: unbound_package

unbound_service:
  service.running:
    - name: unbound
    - enable: True
    - watch:
      - file: unbound_config
    - require:
      - pkg: unbound_package
      - file: unbound_config
      - cmd: unbound_root_key
      - cmd: unbound_validate
