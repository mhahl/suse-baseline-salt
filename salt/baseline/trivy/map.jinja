{# baseline/trivy/map.jinja — pillar-overridable defaults.
   Tumbleweed uses the community package; Fedora provides trivy in its
   base repositories. Both packages install /usr/bin/trivy; a manually
   pinned /usr/local/bin/trivy wins when present (see _modules).
   Overstate contracts: the trivy-cve-scan job name and the
   trivy.scan_summary mine key are stable — do not rename.
   skip_db_update=True means offline scans only: manage the DB
   externally (trivy db update) or results go stale.
   schedule_splay is clamped 0..86400 in schedule.sls (default 600).
   top_n is clamped 0..100 in trivy_scan.py (default 20). #}
{% set trivy = {
  'pkg_version': '',
  'severities': 'HIGH,CRITICAL',
  'top_n': 20,
  'skip_db_update': False,
  'cache_dir': '/var/cache/trivy',
  'report_path': '/var/cache/trivy/report.json',
  'run_initial_scan': True,
  'schedule_splay': 600,
} %}
{% do trivy.update(salt['pillar.get']('baseline:trivy', {})) %}
