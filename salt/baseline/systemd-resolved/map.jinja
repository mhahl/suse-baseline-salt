{# baseline/systemd-resolved/map.jinja — which package provides the resolver.
   Tumbleweed / Leap 16+ / SLE 16+: split `systemd-resolved` subpackage.
   SUSE 15.x (Leap, SLES, SLED): the resolver ships inside the monolithic
   `systemd` package — no separate `systemd-resolved` package exists, so a
   hard `pkg.installed: systemd-resolved` fails there. `systemd` is always
   present, making the install a no-op on 15.x while config + service still
   apply. #}
{% set _family = grains.get('os_family', '') %}
{% set _major = (grains.get('osmajorrelease', '') ~ '') %}
{% if _family == 'Suse' and _major.startswith('15') %}
{% set resolved = {'pkg': 'systemd'} %}
{% else %}
{% set resolved = {'pkg': 'systemd-resolved'} %}
{% endif %}
