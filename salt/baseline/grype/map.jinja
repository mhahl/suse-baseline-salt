{# baseline/grype/map.jinja — DEPRECATED, canonical is overstate/grype/map.jinja.
   Kept as a full copy (not an import shim: Jinja does not re-export
   `{% from ... import %}` names across two hops, so a chained import
   would break `{% from "baseline/grype/map.jinja" import grype %}`).
   Merges legacy baseline:grype first, overstate:grype wins — identical
   to overstate/grype/map.jinja. New code must import from
   "overstate/grype/map.jinja". #}
{% set _default_hashes = {
  'amd64': 'sha256=0a9ee97ef5ae2ee953b0a80098105052e846cdbe319a57d808b519c33cd1343d',
  'arm64': 'sha256=29f47391dc283aa79fcc38e65224cd61f64dec0ecfd0db7074128ebf8ff23514',
} %}
{% set grype = {
  'version': 'v0.120.1',
  'hashes': dict(_default_hashes),
  'severities': 'HIGH,CRITICAL',
  'top_n': 20,
  'skip_db_update': False,
  'cache_dir': '/var/cache/grype',
  'report_path': '/var/cache/grype/report.json',
  'run_initial_scan': True,
  'schedule_splay': 600,
  'nice_level': 19,
} %}
{% set _over = salt['pillar.get']('overstate:grype', {}) %}
{% set _legacy = salt['pillar.get']('baseline:grype', {}) %}
{% set _merged_pillar = {} %}
{% do _merged_pillar.update(_legacy) %}
{% do _merged_pillar.update(_over) %}
{% do grype.update(_merged_pillar) %}
{% set _merged_hashes = dict(_default_hashes) %}
{% if _merged_pillar.get('hashes') is mapping %}
{% do _merged_hashes.update(_merged_pillar.get('hashes')) %}
{% endif %}
{% do grype.update({'hashes': _merged_hashes}) %}
